# Основные настройки
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Безопасность
JWT_SECRET=profi-planner-dev-secret-key-change-in-production
BCRYPT_ROUNDS=10

# Пароль администратора по умолчанию (используется только при первом создании)
# Если не указан, используется 'admin' (небезопасно!)
# Рекомендуется установить надежный пароль перед первым запуском
DEFAULT_ADMIN_PASSWORD=admin

# База данных
DATABASE_PATH=./data/profi-planner.db

# Логирование
LOG_LEVEL=info
LOG_DIR=./logs

# CORS (можно указать несколько через запятую)
# Для локальной разработки:
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,http://192.168.2.104:8080
